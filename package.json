{
  "name": "inpractise-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "typecheck": "pnpm type-check",
    "test": "vitest run --coverage",
    "test:rls": "vitest run tests/integration/rls.test.ts --no-coverage",
    "preflight": "node --import tsx scripts/db/preflight.ts",
    "db:prepare": "node --import tsx scripts/db/prepare.ts",
    "db:verify": "node --import tsx scripts/db/verify.ts",
    "db:import": "node --import tsx scripts/db/import.ts",
    "db:embed": "node --import tsx scripts/db/embed.ts",
    "seed": "node --import tsx scripts/db/seed.ts",
    "eval:retrieval": "node --import tsx scripts/db/evaluate.ts",
    "eval:gate": "node --import tsx scripts/db/gate.ts",
    "lab:publish": "node --import tsx scripts/lab/publishLab.ts",
    "transcripts:ingest": "tsx --tsconfig tsconfig.node.json scripts/transcripts/ingest.ts",
    "transcripts:build": "tsx --tsconfig tsconfig.node.json scripts/transcripts/build.ts",
    "transcripts:correct": "tsx --tsconfig tsconfig.node.json scripts/transcripts/correct.ts",
    "transcripts:fillers": "tsx --tsconfig tsconfig.node.json scripts/transcripts/fillers.ts",
    "transcripts:learn": "tsx --tsconfig tsconfig.node.json scripts/transcripts/learn.ts",
    "transcripts:pairs": "tsx --tsconfig tsconfig.node.json scripts/transcripts/pairs.ts",
    "transcripts:export": "tsx --tsconfig tsconfig.node.json scripts/transcripts/exportPair.ts",
    "transcripts:peaks": "tsx --tsconfig tsconfig.node.json scripts/transcripts/peaks.ts",
    "verify": "pnpm check:ci && pnpm check:quality && pnpm test && pnpm corpus:verify && pnpm db:verify && pnpm conformance",
    "test:db": "vitest run tests/integration/database tests/integration/import --no-coverage",
    "type-check": "pnpm type-check:ci && tsc -p tsconfig.evals.json --noEmit",
    "type-check:ci": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p supabase/functions/tsconfig.json --noEmit && tsc -p tests/browser/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:ci": "eslint . --max-warnings 0 --ignore-pattern 'evals/live/**'",
    "lint:fix": "eslint . --fix",
    "lint:fast": "oxlint --deny-warnings src scripts tests supabase/functions evals mcp server/api",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "fix": "pnpm lint:fix && pnpm format",
    "check:all": "pnpm type-check && pnpm lint && pnpm format:check && pnpm dupes",
    "check:ci": "pnpm lint:fast && pnpm type-check:ci && pnpm check:deno && pnpm lint:ci && pnpm format:check && pnpm test:ci && pnpm test:corpus && pnpm dupes && pnpm knip",
    "check:quality": "pnpm deps:graph && pnpm type-coverage",
    "test:corpus": "node --test scripts/corpus/checks.test.mjs",
    "corpus:verify": "node scripts/corpus/verify.mjs",
    "corpus:podcast": "node scripts/corpus/importPodcast.mjs",
    "dupes": "baseline-dupes src scripts tests supabase/functions evals mcp server/api",
    "knip": "knip",
    "deps:graph": "depcruise src scripts tests supabase/functions evals mcp",
    "type-coverage": "baseline-type-coverage",
    "prepare": "lefthook install",
    "lint:suppress": "eslint . --suppress-all",
    "lint:prune": "eslint . --prune-suppressions",
    "secrets:check": "gitleaks dir --config .gitleaks-source.toml --no-banner --redact .",
    "audit:check": "baseline-audit --level moderate",
    "check:security": "pnpm secrets:check && pnpm audit:check",
    "conformance": "create-baseline --check",
    "test:ci": "vitest run --config vitest.ci.config.ts --coverage && pnpm test:edge",
    "check:deno": "DENO_DIR=node_modules/.cache/deno deno check --config supabase/functions/deno.json \"supabase/functions/**/*.ts\"",
    "eval:answers": "node --import tsx evals/live/run.ts",
    "eval:replay": "node --import tsx evals/replay.ts",
    "mcp": "node --import tsx mcp/start.ts",
    "dev": "vite",
    "build": "vite build && vite build --config vite.api.config.ts",
    "preview": "vite preview",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "test:edge": "DENO_DIR=node_modules/.cache/deno deno test --cached-only --allow-env --config supabase/functions/deno.json supabase/functions/tests",
    "api:spec": "tsx --tsconfig tsconfig.node.json scripts/api/generateOpenApi.ts",
    "api:latency": "node --import tsx scripts/api/measureLatency.ts",
    "db:local:up": "node --import tsx scripts/db/local/up.ts",
    "db:local:down": "node --import tsx scripts/db/local/down.ts",
    "test:db:local": "pnpm db:local:up && vitest run --config vitest.local.config.ts --no-coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-dialog": "1.2.0",
    "@supabase/supabase-js": "2.117.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.42",
    "js-tiktoken": "1.0.21",
    "lucide-react": "1.55.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "@cristiandeluxe/max-lane": "file:../max-lane"
  },
  "devDependencies": {
    "@syntopica/create-baseline": "0.10.3",
    "@syntopica/eslint-config": "^0.9.0",
    "@syntopica/prettier-config": "^0.3.0",
    "@syntopica/quality-config": "0.13.1",
    "@syntopica/tsconfig": "0.3.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/deno": "2.7.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-code-policy": "^0.8.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "77.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "jscpd": "5.4.1",
    "jsdom": "30.1.2",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "node": "26.11.1",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "prettier-plugin-css-order": "2.2.0",
    "prettier-plugin-organize-imports": "4.3.0",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "type-coverage": "2.30.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "deno",
      "version": "2.9.6",
      "onFail": "download"
    }
  }
}
