{
  "name": "research-evidence-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "typecheck": "pnpm type-check",
    "test": "vitest run --coverage",
    "test:rls": "vitest run tests/integration/rls.test.ts --no-coverage",
    "preflight": "node --import tsx scripts/db/preflight.ts",
    "db:prepare": "node --import tsx scripts/db/prepare.ts",
    "db:verify": "node --import tsx scripts/db/verify.ts",
    "db:import": "node --import tsx scripts/db/import.ts",
    "db:embed": "node --import tsx scripts/db/embed.ts",
    "seed": "node --import tsx scripts/db/seed.ts",
    "eval:retrieval": "node --import tsx scripts/db/evaluate.ts",
    "eval:gate": "node --import tsx scripts/db/gate.ts",
    "verify": "pnpm check:ci && pnpm check:quality && pnpm test && pnpm corpus:verify && pnpm db:verify && pnpm conformance",
    "test:db": "vitest run tests/integration/database tests/integration/import --no-coverage",
    "type-check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p supabase/functions/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:fast": "oxlint --deny-warnings src scripts tests supabase/functions evals mcp",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "fix": "pnpm lint:fix && pnpm format",
    "check:all": "pnpm type-check && pnpm lint && pnpm format:check && pnpm dupes",
    "check:ci": "pnpm lint:fast && pnpm type-check && pnpm check:deno && pnpm lint && pnpm format:check && pnpm test:ci && pnpm test:corpus && pnpm dupes && pnpm knip",
    "check:quality": "pnpm deps:graph && pnpm type-coverage",
    "test:corpus": "node --test scripts/corpus/checks.test.mjs",
    "corpus:verify": "node scripts/corpus/verify.mjs",
    "dupes": "baseline-dupes src scripts tests supabase/functions evals mcp",
    "knip": "knip",
    "deps:graph": "depcruise src scripts tests supabase/functions evals mcp",
    "type-coverage": "baseline-type-coverage",
    "prepare": "lefthook install",
    "lint:suppress": "eslint . --suppress-all",
    "lint:prune": "eslint . --prune-suppressions",
    "secrets:check": "gitleaks dir --config .gitleaks-source.toml --no-banner --redact .",
    "audit:check": "baseline-audit --level moderate",
    "check:security": "pnpm secrets:check && pnpm audit:check",
    "conformance": "create-baseline --check",
    "test:ci": "vitest run --config vitest.ci.config.ts --coverage",
    "check:deno": "DENO_DIR=node_modules/.cache/deno deno check --config supabase/functions/deno.json \"supabase/functions/**/*.ts\"",
    "eval:answers": "node --import tsx evals/run.ts",
    "mcp": "node --import tsx mcp/start.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "2.116.0",
    "js-tiktoken": "1.0.21",
    "postgres": "3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@busirocket/create-baseline": "0.9.0",
    "@busirocket/eslint-config": "0.8.0",
    "@busirocket/prettier-config": "0.2.0",
    "@busirocket/quality-config": "0.11.0",
    "@busirocket/tsconfig": "0.3.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@cristiandeluxe/max-lane": "file:../max-lane",
    "@eslint/js": "10.0.1",
    "@types/deno": "2.7.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-code-policy": "0.7.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "eslint-plugin-regexp": "3.3.0",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "74.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "jscpd": "5.2.0",
    "knip": "6.35.1",
    "lefthook": "2.1.12",
    "node": "24.20.0",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "prettier-plugin-css-order": "2.2.0",
    "prettier-plugin-organize-imports": "4.3.0",
    "supabase": "2.75.0",
    "tsx": "4.23.13",
    "type-coverage": "2.30.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "runtime": {
      "name": "deno",
      "version": "2.9.6",
      "onFail": "download"
    }
  }
}
